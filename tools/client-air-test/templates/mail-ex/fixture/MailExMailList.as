package fixture {import pinball.common.data.mail.MailLogic;import pinball.common.data.mail.MailKind;public class MailExMailList {public var rows:Object={};public function MailExMailList(inputs:Array){for each(var row:Object in inputs){if(rows.hasOwnProperty(String(row.mail_id)))throw new Error("Duplicate external mail ID");var m:MailLogic=new MailLogic();m.kind=MailKind.Character(int(row.character_id));rows[String(row.mail_id)]=m;}}public function getById(id:int):MailLogic{if(!rows.hasOwnProperty(String(id)))throw new Error("Missing external mail ID "+id);return rows[String(id)];}}}